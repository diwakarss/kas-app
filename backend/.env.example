# KAS App Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED
# ============================================

# Authentication secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here-change-in-production

# LLM Provider (DeepInfra)
DEEPINFRA_API_KEY=your-deepinfra-api-key

# ============================================
# OAUTH PROVIDERS (Optional - for production)
# ============================================

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ============================================
# STORAGE (MinIO - defaults work for local dev)
# ============================================

# MinIO credentials (change in production)
MINIO_ROOT_USER=kas-minio-dev
MINIO_ROOT_PASSWORD=kas-minio-secret-dev

# ============================================
# CORS (comma-separated origins)
# ============================================

CORS_ORIGINS=http://localhost:3000,http://localhost:7130

# ============================================
# OPTIONAL OVERRIDES
# ============================================

# Override default ports
# INSFORGE_DASHBOARD_PORT=7130
# INSFORGE_API_PORT=7131
# POSTGRES_PORT=5432

# Feature flags
ENABLE_PROGRESS_SSE=true
