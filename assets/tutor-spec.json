  "chat_commands": [
    {
      "pattern": "add student {name}",
      "aliases": ["new student {name}", "create student {name}"],
      "action": {
        "type": "start_add_flow",
        "entity": "Student",
        "pre_fill": {
          "name": "{name}"
        }
      },
      "variables": {
        "name": {
          "type": "text"
        }
      },
      "requires_confirmation": false
    },
    {
      "pattern": "show {name}",
      "aliases": ["open {name}", "{name}'s story", "find {name}"],
      "action": {
        "type": "navigate_to_story",
        "entity": "Student",
        "lookup_field": "name"
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Student",
          "field": "name"
        }
      },
      "requires_confirmation": false
    },
    {
      "pattern": "reschedule {name} to {time}",
      "aliases": ["move {name}'s class to {time}", "change {name} to {time}"],
      "action": {
        "type": "update_field",
        "entity": "Class",
        "lookup_field": "student.name",
        "target_field": "datetime"
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Student",
          "field": "name"
        },
        "time": {
          "type": "datetime"
        }
      },
      "requires_confirmation": true,
      "confirmation_template": "Reschedule {name}'s class to {time}?"
    },
    {
      "pattern": "who owes money",
      "aliases": ["outstanding payments", "dues", "who hasn't paid", "pending payments"],
      "action": {
        "type": "query",
        "name": "overdue_students",
        "description": "Students with due_amount > 0"
      },
      "requires_confirmation": false
    },
    {
      "pattern": "record payment {amount} from {name}",
      "aliases": ["{name} paid {amount}", "payment from {name} {amount}"],
      "action": {
        "type": "record",
        "entity": "Payment",
        "fields": {
          "student_id": "{name}",
          "amount": "{amount}",
          "date": "{today}"
        }
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Student",
          "field": "name"
        },
        "amount": {
          "type": "number"
        }
      },
      "requires_confirmation": true,
      "confirmation_template": "Record Rs.{amount} payment from {name}?"
    },
    {
      "pattern": "add note for {name}: {text}",
      "aliases": ["note for {name}: {text}", "{name} note: {text}"],
      "action": {
        "type": "record",
        "entity": "Note",
        "fields": {
          "student_id": "{name}",
          "content": "{text}",
          "date": "{today}"
        }
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Student",
          "field": "name"
        },
        "text": {
          "type": "text"
        }
      },
      "requires_confirmation": true,
      "confirmation_template": "Add note for {name}: \"{text}\"?"
    },
    {
      "pattern": "schedule class for {name} on {time}",
      "aliases": ["add class for {name} {time}", "book {name} for {time}"],
      "action": {
        "type": "start_add_flow",
        "entity": "Class",
        "pre_fill": {
          "student_id": "{name}",
          "datetime": "{time}"
        }
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Student",
          "field": "name"
        },
        "time": {
          "type": "datetime"
        }
      },
      "requires_confirmation": false
    },
    {
      "pattern": "next week's classes",
      "aliases": ["classes next week", "schedule next week", "what's next week"],
      "action": {
        "type": "query",
        "name": "next_week_classes",
        "description": "All classes scheduled for next week"
      },
      "requires_confirmation": false
    },
    {
      "pattern": "how much did {name} pay this month",
      "aliases": ["{name}'s payments this month", "{name} payment history"],
      "action": {
        "type": "query",
        "name": "student_payments_this_month",
        "description": "Total payments from a student this month"
