      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Student",
          "field": "name"
        }
      },
      "requires_confirmation": false
    },
    {
      "pattern": "mark {name}'s class as completed",
      "aliases": ["{name} class done", "complete {name}'s class"],
      "action": {
        "type": "update_field",
        "entity": "Class",
