  "business_rules": [
    {
      "id": "overdue_payment",
      "name": "Payment overdue",
      "entity": "Student",
      "condition": {
        "type": "computed_field_exceeds",
        "field": "days_since_last_payment",
        "value": 30
      },
      "warning": {
        "message": "Rs.{due_amount} overdue for {name}",
        "severity": "warning",
        "show_in": ["card", "story", "anchor"]
      },
      "threshold": {
        "field": "days_since_last_payment",
        "default_value": 30,
        "label": "Warn after (days)",
        "user_adjustable": true
      }
    },
    {
      "id": "large_due_amount",
      "name": "Large outstanding amount",
      "entity": "Student",
      "condition": {
        "type": "computed_field_exceeds",
        "field": "due_amount",
        "value": 5000
      },
      "warning": {
        "message": "Rs.{due_amount} outstanding — consider sending a reminder",
        "severity": "urgent",
        "show_in": ["story", "notification"]
      },
      "threshold": {
        "field": "due_amount",
        "default_value": 5000,
        "label": "Alert when owed more than (Rs.)",
        "user_adjustable": true
      }
    },
    {
      "id": "no_classes_scheduled",
      "name": "No upcoming classes",
      "entity": "Student",
      "condition": {
        "type": "count_below",
        "field": "upcoming_class_count",
        "value": 1
      },
      "warning": {
        "message": "No upcoming classes scheduled",
        "severity": "info",
        "show_in": ["story"]
      }
    }
  ],

  "computed_fields": {
    "Student": [
      {
        "name": "total_classes",
        "display_name": "Total Classes",
        "type": "count",
        "source_entity": "Class",
        "relationship": "student_id",
        "filter": {
          "field": "status",
          "condition": "equals",
          "value": "completed"
        },
        "format": "number"
      },
      {
        "name": "total_paid",
        "display_name": "Total Paid",
        "type": "sum",
        "source_entity": "Payment",
        "source_field": "amount",
        "relationship": "student_id",
        "format": "currency",
        "prefix": "Rs."
      },
      {
        "name": "total_earned",
        "display_name": "Total Earned",
        "type": "formula",
        "formula": "total_classes * hourly_fee",
        "format": "currency",
        "prefix": "Rs."
      },
      {
        "name": "due_amount",
        "display_name": "Amount Due",
        "type": "formula",
        "formula": "total_earned - total_paid",
        "format": "currency",
        "prefix": "Rs."
      },
      {
        "name": "days_since_last_payment",
        "display_name": "Days Since Last Payment",
        "type": "days_since",
        "source_entity": "Payment",
        "relationship": "student_id",
        "date_field": "date",
        "format": "number",
        "suffix": "days"
      },
      {
        "name": "upcoming_class_count",
        "display_name": "Upcoming Classes",
        "type": "count",
        "source_entity": "Class",
        "relationship": "student_id",
        "filter": {
          "field": "status",
          "condition": "equals",
          "value": "scheduled"
        },
        "format": "number"
      },
      {
        "name": "last_class_date",
        "display_name": "Last Class",
        "type": "latest",
        "source_entity": "Class",
        "relationship": "student_id",
        "date_field": "datetime",
        "filter": {
          "field": "status",
          "condition": "equals",
          "value": "completed"
        },
        "format": "date"
      }
    ],
    "Class": [
      {
        "name": "earnings",
        "display_name": "Class Earnings",
        "type": "formula",
        "formula": "(duration / 60) * student.hourly_fee",
        "format": "currency",
        "prefix": "Rs."
      }
    ]
  }
}
