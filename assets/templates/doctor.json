  "anchor": {
    "type": "day_schedule",
    "entity": "Appointment",
    "greeting_template": "Good {time_of_day}! Here's your schedule",
    "date_label": "Today",
    "card_display": {
      "title": "{Patient.name}",
      "subtitle": "{reason}",
      "time_field": "datetime",
      "warning_field": "status",
      "warning_template": "Status: {status}",
      "actions": ["view_patient", "mark_completed", "reschedule"]
    },
    "empty_state": {
      "message": "No appointments scheduled",
      "action": "Schedule Appointment",
      "fallback_view": "patient_list"
    },
    "summary": {
      "stats": [
        { "label": "Today", "query": "COUNT(*) WHERE DATE(datetime) = DATE('now')" },
        { "label": "This Week", "query": "COUNT(*) WHERE datetime >= DATE('now', 'weekday 0', '-6 days')" }
      ]
    }
  },

  "story_events": {
    "Patient": {
      "events": [
        {
          "source": "Appointment",
          "relationship": "patient_id",
          "type": "appointment",
          "display": "{datetime} - {reason}",
          "icon_color": "#4CAF50"
        },
        {
          "source": "Prescription",
          "relationship": "patient_id",
          "type": "prescription",
          "display": "{date} - {diagnosis}",
          "icon_color": "#2196F3"
        },
        {
          "source": "Note",
          "relationship": "patient_id",
          "type": "note",
          "display": "{date} - {content}",
          "icon_color": "#FF9800"
        }
      ],
      "stats_card": [
        { "label": "Total Visits", "computed": "total_visits" },
        { "label": "Last Visit", "computed": "last_visit" },
        { "label": "Next Appointment", "computed": "next_appointment" }
      ],
      "coming_up": {
        "source": "Appointment",
        "relationship": "patient_id",
        "filter": "datetime > datetime('now') AND status = 'scheduled'",
        "sort": "datetime ASC",
        "display": "{datetime} - {reason}"
      },
      "origin": {
        "display": "Patient since {created_at}"
      },
      "context": {
        "display": "{phone}"
      }
    }
  },

