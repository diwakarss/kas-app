  "search": {
    "entities": ["Patient", "Prescription"],
    "display": {
      "Patient": "{name} - {phone}",
      "Prescription": "{Patient.name} - {diagnosis}"
    }
  },

  "calendar": {
    "entity": "Appointment",
    "date_field": "datetime",
    "display": "{Patient.name} - {reason}",
    "color_field": "status"
  },

  "chat_commands": [
    {
      "pattern": "add patient {name}",
      "aliases": ["new patient", "register patient"],
      "action": {
        "type": "create",
        "entity": "Patient",
        "fields": { "name": "{name}" }
      },
      "variables": {
        "name": { "type": "text" }
      },
      "requires_confirmation": false
    },
    {
      "pattern": "schedule {patient_name} {datetime}",
      "aliases": ["book appointment", "add appointment"],
      "action": {
        "type": "create_related",
        "entity": "Appointment",
        "lookup_field": "name",
        "target_field": "patient_id",
        "pre_fill": { "datetime": "{datetime}", "status": "scheduled" }
      },
      "variables": {
        "patient_name": { "type": "entity", "entity": "Patient", "field": "name" },
        "datetime": { "type": "datetime" }
      },
      "requires_confirmation": true,
      "confirmation_template": "Schedule {patient_name} for {datetime}?"
    },
    {
      "pattern": "today's patients",
      "aliases": ["today appointments", "schedule today"],
      "action": {
        "type": "query",
        "entity": "Appointment",
        "name": "today_appointments",
        "description": "Show all appointments for today"
      },
      "requires_confirmation": false
    },
    {
      "pattern": "prescribe {patient_name}",
      "aliases": ["new prescription", "write prescription"],
      "action": {
        "type": "create_related",
        "entity": "Prescription",
        "lookup_field": "name",
        "target_field": "patient_id"
      },
      "variables": {
        "patient_name": { "type": "entity", "entity": "Patient", "field": "name" }
      },
      "requires_confirmation": false
    }
  ],

  "business_rules": [
    {
      "id": "missed_followup",
      "name": "Missed Follow-up",
      "entity": "Patient",
      "condition": {
        "type": "computed_field_exceeds",
        "field": "days_since_last_visit",
        "value": 90
      },
      "warning": {
        "message": "No visit in {days_since_last_visit} days",
        "severity": "warning",
        "show_in": ["story", "search"]
      },
      "threshold": {
        "field": "days_since_last_visit",
        "default_value": 90,
        "label": "Days without visit",
        "user_adjustable": true
      }
    },
    {
      "id": "upcoming_followup",
      "name": "Upcoming Follow-up",
      "entity": "Prescription",
      "condition": {
        "type": "date_passed",
        "field": "follow_up_date"
      },
      "warning": {
        "message": "Follow-up due",
        "severity": "info",
        "show_in": ["story"]
      }
    }
  ],

  "computed_fields": {
    "Patient": [
      {
        "name": "total_visits",
        "display_name": "Total Visits",
        "type": "count",
        "source_entity": "Appointment",
        "relationship": "patient_id",
        "filter": {
          "field": "status",
          "condition": "=",
          "value": "completed"
        }
      },
      {
        "name": "last_visit",
        "display_name": "Last Visit",
        "type": "latest",
        "source_entity": "Appointment",
        "relationship": "patient_id",
        "date_field": "datetime",
        "filter": {
          "field": "status",
          "condition": "=",
          "value": "completed"
        },
        "format": "relative"
      },
      {
        "name": "days_since_last_visit",
        "display_name": "Days Since Last Visit",
        "type": "days_since",
        "source_entity": "Appointment",
        "relationship": "patient_id",
        "date_field": "datetime",
        "filter": {
          "field": "status",
          "condition": "=",
          "value": "completed"
        }
      },
      {
        "name": "next_appointment",
        "display_name": "Next Appointment",
        "type": "latest",
        "source_entity": "Appointment",
        "relationship": "patient_id",
        "date_field": "datetime",
        "filter": {
          "field": "status",
          "condition": "=",
          "value": "scheduled"
        },
        "format": "relative"
      },
      {
        "name": "total_prescriptions",
        "display_name": "Total Prescriptions",
        "type": "count",
        "source_entity": "Prescription",
        "relationship": "patient_id"
      }
    ]
  }
