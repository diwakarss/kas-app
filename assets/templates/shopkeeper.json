  "chat_commands": [
    {
      "pattern": "add customer {name}",
      "aliases": ["new customer {name}", "create customer {name}"],
      "action": {
        "type": "start_add_flow",
        "entity": "Customer",
        "pre_fill": {
          "name": "{name}"
        }
      },
      "variables": {
        "name": {
          "type": "text"
        }
      },
      "requires_confirmation": false
    },
    {
      "pattern": "new sale",
      "aliases": ["add sale", "record sale", "add transaction"],
      "action": {
        "type": "start_add_flow",
        "entity": "Transaction"
      },
      "requires_confirmation": false
    },
    {
      "pattern": "credit list",
      "aliases": ["show credits", "pending credits", "who owes", "udhar list"],
      "action": {
        "type": "query",
        "name": "unsettled_credits",
        "description": "All customers with unsettled credit"
      },
      "requires_confirmation": false
    },
    {
      "pattern": "today sales",
      "aliases": ["today's sales", "sales today", "aaj ki sale"],
      "action": {
        "type": "query",
        "name": "today_transactions",
        "description": "All transactions recorded today"
      },
      "requires_confirmation": false
    },
    {
      "pattern": "show {name}",
      "aliases": ["open {name}", "{name}'s story", "find {name}"],
      "action": {
        "type": "navigate_to_story",
        "entity": "Customer",
        "lookup_field": "name"
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Customer",
          "field": "name"
        }
      },
      "requires_confirmation": false
    },
    {
      "pattern": "record sale {amount} from {name}",
      "aliases": ["{name} bought {amount}", "sale from {name} {amount}"],
      "action": {
        "type": "record",
        "entity": "Transaction",
        "fields": {
          "customer_id": "{name}",
          "amount": "{amount}",
          "date": "{today}"
        }
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Customer",
          "field": "name"
        },
        "amount": {
          "type": "number"
        }
      },
      "requires_confirmation": true,
      "confirmation_template": "Record Rs.{amount} sale from {name}?"
    },
    {
      "pattern": "add credit {amount} for {name}",
      "aliases": ["{name} credit {amount}", "udhar {amount} for {name}"],
      "action": {
        "type": "record",
        "entity": "Credit",
        "fields": {
          "customer_id": "{name}",
          "amount": "{amount}",
          "date": "{today}"
        }
      },
      "variables": {
        "name": {
          "type": "field_value",
          "entity": "Customer",
          "field": "name"
        },
        "amount": {
          "type": "number"
        }
      },
      "requires_confirmation": true,
      "confirmation_template": "Add Rs.{amount} credit for {name}?"
    }
  ],

  "business_rules": [
    {
      "id": "high_credit",
      "name": "High credit pending",
      "entity": "Customer",
      "condition": {
        "type": "computed_field_exceeds",
        "field": "outstanding_balance",
        "value": 500
      },
      "warning": {
        "message": "Rs.{outstanding_balance} credit pending for {name}",
        "severity": "warning",
        "show_in": ["card", "story", "anchor"]
      },
      "threshold": {
        "field": "outstanding_balance",
        "default_value": 500,
        "label": "Warn when credit exceeds (Rs.)",
        "user_adjustable": true
      }
    },
    {
      "id": "inactive_customer",
      "name": "Inactive customer",
      "entity": "Customer",
      "condition": {
        "type": "computed_field_exceeds",
        "field": "days_since_last_visit",
        "value": 30
      },
      "warning": {
        "message": "{name} hasn't visited in {days_since_last_visit} days",
        "severity": "info",
        "show_in": ["story"]
      },
      "threshold": {
        "field": "days_since_last_visit",
        "default_value": 30,
        "label": "Warn after inactive (days)",
        "user_adjustable": true
      }
    }
  ],

  "computed_fields": {
    "Customer": [
      {
        "name": "total_purchases",
        "display_name": "Total Purchases",
        "type": "count",
        "source_entity": "Transaction",
        "relationship": "customer_id",
        "format": "number"
      },
      {
        "name": "total_spent",
        "display_name": "Total Spent",
        "type": "sum",
        "source_entity": "Transaction",
        "source_field": "amount",
        "relationship": "customer_id",
        "format": "currency",
        "prefix": "Rs."
      },
      {
        "name": "total_credit",
        "display_name": "Total Credit (Unsettled)",
        "type": "sum",
        "source_entity": "Credit",
        "source_field": "amount",
        "relationship": "customer_id",
        "filter": {
          "field": "settled",
          "condition": "equals",
          "value": "0"
        },
        "format": "currency",
        "prefix": "Rs."
      },
      {
        "name": "total_settled",
        "display_name": "Total Settled",
        "type": "sum",
        "source_entity": "Credit",
        "source_field": "amount",
        "relationship": "customer_id",
        "filter": {
          "field": "settled",
          "condition": "equals",
          "value": "1"
        },
        "format": "currency",
        "prefix": "Rs."
      },
      {
        "name": "outstanding_balance",
        "display_name": "Outstanding Balance",
        "type": "formula",
        "formula": "total_credit - total_settled",
        "format": "currency",
        "prefix": "Rs."
      },
      {
        "name": "days_since_last_visit",
        "display_name": "Days Since Last Visit",
        "type": "days_since",
        "source_entity": "Transaction",
        "relationship": "customer_id",
        "date_field": "date",
        "format": "number",
        "suffix": "days"
      },
      {
        "name": "last_visit_date",
        "display_name": "Last Visit",
        "type": "latest",
        "source_entity": "Transaction",
        "relationship": "customer_id",
        "date_field": "date",
        "format": "date"
      }
    ]
  }
