  "anchor": {
    "type": "yesterday_summary",
    "entity": "Transaction",
    "greeting_template": "Good {time_of_day}, {user_name}",
    "date_label": "yesterday",
    "card_display": {
      "title": "{customer.name}",
      "subtitle": "Rs.{amount} - {payment_method}",
      "time_field": "date",
      "warning_field": "customer.outstanding_balance",
      "warning_template": "Rs.{customer.outstanding_balance} credit pending",
      "actions": ["edit", "delete"]
    },
    "empty_state": {
      "message": "No sales yesterday",
      "action": "Record a sale",
      "fallback_view": "calendar"
    },
    "summary": {
      "stats": [
        {
          "label": "Yesterday's sales",
          "query": "yesterday_sale_count"
        },
        {
          "label": "Total amount",
          "query": "yesterday_total_amount"
        }
      ]
    }
  },

  "story_events": {
    "Customer": {
      "events": [
        {
          "source": "Transaction",
          "relationship": "customer_id",
          "type": "purchase",
          "display": "{items_description} — Rs.{amount} ({payment_method})",
          "icon_color": "bloom"
        },
        {
          "source": "Transaction",
          "relationship": "customer_id",
          "type": "purchase_cash",
          "filter": {
            "field": "payment_method",
            "value": "cash"
          },
          "display": "{items_description} — Rs.{amount} (cash)",
          "icon_color": "bloom"
        },
        {
          "source": "Transaction",
          "relationship": "customer_id",
          "type": "purchase_upi",
          "filter": {
            "field": "payment_method",
            "value": "upi"
          },
          "display": "{items_description} — Rs.{amount} (upi)",
          "icon_color": "stream"
        },
        {
          "source": "Transaction",
          "relationship": "customer_id",
          "type": "purchase_credit",
          "filter": {
            "field": "payment_method",
            "value": "credit"
          },
          "display": "{items_description} — Rs.{amount} (credit)",
          "icon_color": "mist"
        },
        {
          "source": "Credit",
          "relationship": "customer_id",
          "type": "credit",
          "display": "Credit: Rs.{amount} — {reason}",
          "icon_color": "mist"
