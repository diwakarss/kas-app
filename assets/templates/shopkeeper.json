          "field": "phone"
        },
        {
          "label": "{total_purchases} purchases",
          "computed": "total_purchases"
        },
        {
          "label": "Rs.{outstanding_balance} pending",
          "computed": "outstanding_balance"
        }
      ],
      "coming_up": null,
      "origin": {
        "display": "{created_at} - {total_purchases} transactions"
      },
      "context": {
        "display": "Customer since {created_at}"
      }
    }
